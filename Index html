<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FREE FIRE: SPACE WARRIORS</title>
  <style>
    :root{
      --bg: #030b1d;
      --panel: rgba(7,17,36,0.8);
      --panel-strong: rgba(10, 20, 42, 0.92);
      --primary: #35d7ff;
      --secondary: #ff7d00;
      --success: #7df9b2;
      --danger: #ff4d6d;
      --gold: #ffd166;
      --text: #edf8ff;
      --muted: #9ab3c9;
      --shadow: rgba(0,0,0,0.38);
    }

    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at top, #0a1637 0%, #020811 45%, #000 100%);
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
      overflow: hidden;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #game-shell {
      position: relative;
      width: min(100vw, 1400px);
      height: min(100vh, 820px);
      max-width: 100%;
      max-height: 100vh;
      border: 2px solid rgba(125, 210, 255, 0.25);
      box-shadow: 0 0 30px rgba(53, 215, 255, 0.25), 0 0 8px rgba(0,0,0,0.8);
      background: #030b1d;
      overflow: hidden;
    }

    canvas {
      display: block;
      width: 100%;
      height: 100%;
      background: linear-gradient(#060d18, #09182f 45%, #030d18);
    }

    .overlay {
      position: absolute;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(2, 8, 17, 0.72);
      backdrop-filter: blur(4px);
      z-index: 20;
    }

    .overlay.visible {
      display: flex;
    }

    .panel {
      width: min(90%, 860px);
      min-height: 280px;
      background: linear-gradient(180deg, rgba(12,25,45,0.94), rgba(7,17,35,0.96));
      border: 1px solid rgba(105,178,255,0.35);
      box-shadow: 0 20px 60px rgba(0,0,0,0.6);
      padding: 28px;
      border-radius: 18px;
      text-align: center;
    }

    .title {
      margin: 8px 0 16px;
      font-size: clamp(2.1rem, 4vw, 4rem);
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #d9f7ff;
      text-shadow: 0 0 16px rgba(53, 215, 255, 0.8);
    }

    .subtitle {
      color: var(--muted);
      margin-bottom: 24px;
      font-size: 1rem;
      line-height: 1.5;
    }

    .button-row {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px;
    }

    button {
      border: 0;
      cursor: pointer;
      background: linear-gradient(180deg, #1a7cff, #123f95);
      color: white;
      padding: 12px 18px;
      font-size: 1rem;
      font-weight: 700;
      border-radius: 12px;
      box-shadow: 0 5px 18px rgba(32, 105, 255, 0.28);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(32, 105, 255, 0.35);
    }

    button.secondary {
      background: linear-gradient(180deg, #3e536d, #1f2d43);
      box-shadow: 0 5px 18px rgba(0,0,0,0.2);
    }

    button.gold {
      background: linear-gradient(180deg, #ffb703, #d97706);
      color: #1b0d00;
    }

    #hud {
      position: absolute;
      inset: 0 0 auto 0;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 16px;
      z-index: 10;
      pointer-events: none;
    }

    .hud-group {
      background: rgba(7,18,38,0.7);
      border: 1px solid rgba(109, 171, 255, 0.35);
      border-radius: 12px;
      padding: 10px 14px;
      min-width: 220px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.18);
    }

    .stat {
      margin: 6px 0;
      font-size: 0.9rem;
      color: var(--text);
    }

    .bar-wrap {
      width: 100%;
      height: 14px;
      border-radius: 999px;
      background: rgba(255,255,255,0.08);
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.14);
    }

    .bar {
      height: 100%;
      width: 50%;
      border-radius: 999px;
      transition: width 0.2s ease;
    }

    .bar.health { background: linear-gradient(90deg, #ff4d6d, #ff7c77); }
    .bar.energy { background: linear-gradient(90deg, #22c1ff, #5eead4); }
    .bar.shield { background: linear-gradient(90deg, #8ec5fc, #e0c3fc); }

    #missionText {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      top: 20px;
      z-index: 14;
      background: rgba(10, 14, 26, 0.7);
      border: 1px solid rgba(102,175,255,0.3);
      color: var(--text);
      padding: 10px 18px;
      border-radius: 999px;
      min-width: 250px;
      text-align: center;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.75rem;
    }

    #toast {
      position: absolute;
      left: 50%;
      bottom: 22px;
      transform: translateX(-50%);
      background: rgba(7,17,31,0.85);
      color: var(--text);
      border: 1px solid rgba(101,165,255,0.35);
      box-shadow: 0 14px 35px rgba(0,0,0,0.35);
      padding: 10px 16px;
      border-radius: 999px;
      font-size: 0.9rem;
      opacity: 0;
      transition: opacity 0.25s ease;
      z-index: 30;
      pointer-events: none;
    }

    #toast.show {
      opacity: 1;
    }

    .settings-row {
      display: grid;
      gap: 12px;
      max-width: 500px;
      margin: 20px auto 0;
      text-align: left;
    }

    .setting {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 14px;
      background: rgba(18,30,48,0.7);
      border-radius: 10px;
      border: 1px solid rgba(116,172,255,0.2);
    }

    .setting span { color: var(--muted); }
    .setting input[type="checkbox"] {
      width: 18px;
      height: 18px;
    }

    #destinations {
      display: grid;
      grid-template-columns: repeat(2, minmax(220px, 1fr));
      gap: 16px;
      margin-top: 22px;
    }

    .planet-card {
      background: rgba(12, 26, 48, 0.9);
      border: 1px solid rgba(116,178,255,0.28);
      border-radius: 16px;
      padding: 18px;
      text-align: left;
      min-height: 130px;
      color: var(--text);
      position: relative;
      overflow: hidden;
    }

    .planet-card::before{
      content:"";
      position:absolute;
      inset:0 auto auto 0;
      width:100%;
      height:100%;
      background: radial-gradient(circle at center, rgba(255,255,255,0.12), transparent 30%);
      pointer-events:none;
    }

    .planet-card h3 {
      font-size: 1.4rem;
      margin: 0 0 8px;
    }

    .planet-card p {
      color: var(--muted);
      margin: 0 0 12px;
      line-height: 1.5;
      font-size: 0.92rem;
    }

    .moon { background: linear-gradient(180deg, rgba(29, 41, 60, 0.9), rgba(16, 22, 31, 0.95)); }
    .mars { background: linear-gradient(180deg, rgba(84, 36, 24, 0.92), rgba(33, 16, 11, 0.95)); }

    #touchControls {
      position: absolute;
      left: 10px;
      bottom: 10px;
      z-index: 12;
      display: none;
      gap: 8px;
      pointer-events: auto;
    }

    .touch-pad {
      display: grid;
      grid-template-columns: repeat(3, 46px);
      grid-template-rows: repeat(3, 46px);
      gap: 6px;
    }

    .touch-btn {
      background: rgba(17, 30, 46, 0.7);
      border: 1px solid rgba(127, 174, 255, 0.4);
      color: white;
      border-radius: 12px;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      user-select: none;
      touch-action: none;
    }

    #rightActions {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-left: 12px;
    }

    #fireBtn, #interactBtn {
      width: 80px;
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      font-size: 0.9rem;
      padding: 0;
    }

    @media (max-width: 800px) {
      #touchControls { display: flex; }
      .hud-group {
        min-width: 160px;
        padding: 8px 10px;
      }
      #missionText {
        top: 80px;
        font-size: 0.7rem;
      }
    }
  </style>
</head>
<body>
  <div id="game-shell">
    <canvas id="gameCanvas" width="1400" height="820"></canvas>

    <div id="hud">
      <div class="hud-group">
        <div class="stat"><strong>Player:</strong> <span id="playerName">Astra</span></div>
        <div class="stat">Health</div>
        <div class="bar-wrap"><div class="bar health" id="healthBar"></div></div>
        <div class="stat">Energy</div>
        <div class="bar-wrap"><div class="bar energy" id="energyBar"></div></div>
        <div class="stat">Shields</div>
        <div class="bar-wrap"><div class="bar shield" id="shieldBar"></div></div>
      </div>

      <div id="missionText">Mission: Secure the Island</div>

      <div class="hud-group" style="text-align:right;">
        <div class="stat"><strong>Coins:</strong> <span id="coinCount">0</span></div>
        <div class="stat"><strong>Ammo:</strong> <span id="ammoCount">18</span></div>
        <div class="stat"><strong>Mission:</strong> <span id="missionState">Earth</span></div>
        <div class="stat"><strong>Location:</strong> <span id="locationState">Tropical Island</span></div>
      </div>
    </div>

    <div id="toast">Mission Updated</div>

    <div id="touchControls">
      <div class="touch-pad">
        <div></div>
        <button class="touch-btn" data-key="ArrowUp">↑</button>
        <div></div>

        <button class="touch-btn" data-key="ArrowLeft">←</button>
        <button class="touch-btn" data-key="ArrowDown">↓</button>
        <button class="touch-btn" data-key="ArrowRight">→</button>
      </div>
      <div id="rightActions">
        <button id="interactBtn" class="secondary">Interact</button>
        <button id="fireBtn" class="gold">Fire</button>
      </div>
    </div>

    <div id="mainMenu" class="overlay visible">
      <div class="panel">
        <div class="title">Free Fire: Space Warriors</div>
        <div class="subtitle">
          Earth to Mars — survive the island, launch to space, conquer the Moon and Mars.
        </div>
        <div class="button-row">
          <button id="startBtn">Start Mission</button>
          <button id="settingsBtn" class="secondary">Settings</button>
          <button id="missionBtn" class="secondary">Mission Select</button>
        </div>
      </div>
    </div>

    <div id="settingsOverlay" class="overlay">
      <div class="panel">
        <div class="title" style="font-size: clamp(1.7rem, 2vw, 2.4rem);">Settings</div>
        <div class="settings-row">
          <div class="setting">
            <span>Sound FX</span>
            <input type="checkbox" checked />
          </div>
          <div class="setting">
            <span>Music</span>
            <input type="checkbox" checked />
          </div>
          <div class="setting">
            <span>Low-end Performance Mode</span>
            <input type="checkbox" id="performanceToggle" />
          </div>
        </div>
        <div class="button-row" style="margin-top: 24px;">
          <button id="closeSettingsBtn">Back</button>
        </div>
      </div>
    </div>

    <div id="missionOverlay" class="overlay">
      <div class="panel">
        <div class="title" style="font-size: clamp(1.7rem, 2vw, 2.4rem);">Mission Select</div>
        <div id="destinations">
          <div class="planet-card moon">
            <h3>Moon</h3>
            <p>Battle through craters, moon bases, and abandoned stations. Defeat enemy raiders and collect lunar gold.</p>
            <button class="gold" data-destination="moon">Travel to Moon</button>
          </div>
          <div class="planet-card mars">
            <h3>Mars</h3>
            <p>Explore the red deserts, caves, and alien ruins while building a powerful Mars base and collecting rare rewards.</p>
            <button class="gold" data-destination="mars">Travel to Mars</button>
          </div>
        </div>
      </div>
    </div>

    <div id="pauseOverlay" class="overlay">
      <div class="panel">
        <div class="title" style="font-size: clamp(1.5rem,2vw,2.5rem);">Game Paused</div>
        <div class="button-row">
          <button id="resumeBtn">Resume</button>
          <button id="menuBtn" class="secondary">Main Menu</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');

    const ui = {
      healthBar: document.getElementById('healthBar'),
      energyBar: document.getElementById('energyBar'),
      shieldBar: document.getElementById('shieldBar'),
      coinCount: document.getElementById('coinCount'),
      ammoCount: document.getElementById('ammoCount'),
      missionText: document.getElementById('missionText'),
      missionState: document.getElementById('missionState'),
      locationState: document.getElementById('locationState'),
      toast: document.getElementById('toast'),
      mainMenu: document.getElementById('mainMenu'),
      settingsOverlay: document.getElementById('settingsOverlay'),
      missionOverlay: document.getElementById('missionOverlay'),
      pauseOverlay: document.getElementById('pauseOverlay'),
      performanceToggle: document.getElementById('performanceToggle')
    };

    const keys = {};
    const pointer = { x: 0, y: 0 };

    const world = {
      width: 2600,
      height: 1800,
      earth: {
        x: 0, y: 0, w: 2600, h: 1800
      },
      expedition: {
        x: 0, y: 0, w: 1800, h: 1200
      }
    };

    const game = {
      started: false,
      paused: false,
      isMobile: /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent),
      performanceMode: false,
      scene: 'earth', // earth, launch, space, moon, mars
      view: { x: 0, y: 0, w: canvas.width, h: canvas.height },
      cameraShake: 0,
      gameTime: 0
    };

    const player = {
      x: 1100,
      y: 1050,
      vx: 0,
      vy: 0,
      angle: 0,
      radius: 18,
      speed: 280,
      sprintSpeed: 360,
      health: 100,
      energy: 100,
      shield: 100,
      ammo: 18,
      coins: 0,
      interactRange: 80,
      fireCooldown: 0,
      facing: { x: 1, y: 0 }
    };

    const rocket = {
      active: false,
      stage: 'waiting',
      x: 1170,
      y: 1020,
      width: 90,
      height: 150,
      progress: 0,
      launchPhase: 0,
      targetY: 0
    };

    const mission = {
      current: 'Secure the Island',
      targetKills: 0,
      kills: 0,
      objective: 'Collect supplies and reach the rocket station.',
      destination: null
    };

    const worldObjects = {
      buildings: [],
      roads: [],
      trees: [],
      coins: [],
      enemies: [],
      supplyCrates: [],
      rocketStation: null
    };

    function clamp(value, min, max) {
      return Math.min(Math.max(value, min), max);
    }

    function rand(min, max) {
      return Math.random() * (max - min) + min;
    }

    function showToast(msg) {
      ui.toast.textContent = msg;
      ui.toast.classList.add('show');
      clearTimeout(showToast._timer);
      showToast._timer = setTimeout(() => ui.toast.classList.remove('show'), 1800);
    }

    function setMission(text, objective) {
      mission.current = text;
      mission.objective = objective;
      ui.missionText.textContent = 'Mission: ' + text;
      ui.missionState.textContent = mission.current;
      if (mission.current === 'Earth') {
        ui.locationState.textContent = 'Tropical Island';
      }
    }

    function generateWorld() {
      worldObjects.buildings = [];
      worldObjects.trees = [];
      worldObjects.coins = [];
      worldObjects.enemies = [];
      worldObjects.supplyCrates = [];
      worldObjects.rocketStation = {
        x: 1540, y: 1120, w: 220, h: 220
      };

      // Roads
      worldObjects.roads.push({ x: 340, y: 460, w: 1800, h: 90, angle: 0 });
      worldObjects.roads.push({ x: 720, y: 760, w: 1100, h: 90, angle: 0.3 });
      worldObjects.roads.push({ x: 960, y: 1300, w: 700, h: 90, angle: 0.15 });

      // Houses and buildings
      for (let i = 0; i < 24; i++) {
        const x = 300 + ((i * 137) % 1600);
        const y = 260 + ((i * 89) % 1300);
        if (Math.abs(x - worldObjects.rocketStation.x) < 260 && Math.abs(y - worldObjects.rocketStation.y) < 260) continue;
        worldObjects.buildings.push({
          x, y, w: 60 + Math.random() * 36, h: 55 + Math.random() * 48, color: i % 2 ? '#4b5d6a' : '#5a4a3d'
        });
      }

      // Forest / trees
      for (let i = 0; i < 110; i++) {
        worldObjects.trees.push({
          x: 80 + Math.random() * 2300,
          y: 120 + Math.random() * 1560,
          r: 18 + Math.random() * 22
        });
      }

      // Supply crates and coins
      for (let i = 0; i < 18; i++) {
        worldObjects.supplyCrates.push({
          x: 200 + Math.random() * 2000,
          y: 200 + Math.random() * 1400,
          r: 18
        });
      }

      for (let i = 0; i < 24; i++) {
        const side = i % 2 === 0 ? 1 : -1;
        worldObjects.coins.push({
          x: 220 + Math.random() * 2100,
          y: 190 + Math.random() * 1460,
          radius: 8,
          value: 1
        });
      }

      // Enemies
      for (let i = 0; i < 14; i++) {
        worldObjects.enemies.push({
          x: 450 + Math.random() * 1700,
          y: 300 + Math.random() * 1300,
          radius: 18,
          hp: 50 + Math.random() * 30,
          speed: 50 + Math.random() * 40,
          alive: true,
          kind: i % 3 === 0 ? 'raider' : i % 2 === 0 ? 'assassin' : 'guard',
          cooldown: 0
        });
      }
    }

    function resetPlayerForEarth() {
      player.x = 1100;
      player.y = 1050;
      player.health = 100;
      player.energy = 100;
      player.shield = 100;
      player.ammo = 18;
      player.coins = 0;
      player.fireCooldown = 0;
      player.energy = 100;
      mission.kills = 0;
      mission.current = 'Secure the Island';
      mission.objective = 'Collect supplies, defeat enemies, and reach the launch station.';
      mission.destination = null;
      ui.locationState.textContent = 'Tropical Island';
      ui.missionState.textContent = 'Earth';
      ui.missionText.textContent = 'Mission: Secure the Island';
      worldObjects.enemies.forEach(e => {
        e.alive = true;
        e.hp = 50 + Math.random() * 30;
      });
    }

    function updateHud() {
      const hpPct = clamp(player.health / 100, 0, 1) * 100;
      const energyPct = clamp(player.energy / 100, 0, 1) * 100;
      const shieldPct = clamp(player.shield / 100, 0, 1) * 100;

      ui.healthBar.style.width = hpPct + '%';
      ui.energyBar.style.width = energyPct + '%';
      ui.shieldBar.style.width = shieldPct + '%';

      ui.coinCount.textContent = player.coins;
      ui.ammoCount.textContent = player.ammo;

      if (game.scene === 'earth') {
        ui.locationState.textContent = 'Tropical Island';
      } else if (game.scene === 'moon') {
        ui.locationState.textContent = 'Moon Basin';
      } else if (game.scene === 'mars') {
        ui.locationState.textContent = 'Mars Frontier';
      } else if (game.scene === 'space') {
        ui.locationState.textContent = 'Deep Space';
      } else if (game.scene === 'launch') {
        ui.locationState.textContent = 'Rocket Launch';
      }
    }

    function drawBackground() {
      if (game.scene === 'earth') {
        const g = ctx.createLinearGradient(0, 0, 0, canvas.height);
        g.addColorStop(0, '#0b1833');
        g.addColorStop(0.5, '#143a59');
        g.addColorStop(1, '#0a1a29');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // island terrain
        ctx.fillStyle = '#2f8f4d';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // roads
        ctx.fillStyle = '#382b2a';
        for (const road of worldObjects.roads) {
          const rx = road.x - game.view.x;
          const ry = road.y - game.view.y;
          ctx.save();
          ctx.translate(rx + road.w / 2, ry + road.h / 2);
          ctx.rotate(road.angle);
          ctx.fillRect(-road.w / 2, -road.h / 2, road.w, road.h);
          ctx.restore();
        }

        // sea
        ctx.fillStyle = rgba(25, 105, 146, 0.7);
        ctx.fillRect(0, canvas.height - 110, canvas.width, canvas.height);

        // mountains
        ctx.fillStyle = '#4d604a';
        for (let i = 0; i < 8; i++) {
          const x = i * 220 - (game.view.x * 0.1) % 220;
          const y = 260 + (i % 2) * 30;
          ctx.beginPath();
          ctx.moveTo(x, canvas.height);
          ctx.lineTo(x + 120, y);
          ctx.lineTo(x + 260, canvas.height);
          ctx.closePath();
          ctx.fill();
        }

        // forest
        ctx.fillStyle = '#0f5d32';
        for (const t of worldObjects.trees) {
          const x = t.x - game.view.x;
          const y = t.y - game.view.y;
          if (x < -20 || x > canvas.width + 20 || y < -20 || y > canvas.height + 20) continue;
          ctx.beginPath();
          ctx.fillStyle = '#1f7d4a';
          ctx.arc(x, y, t.r, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#2d8b4d';
          ctx.beginPath();
          ctx.arc(x - 8, y - 2, t.r * 0.8, 0, Math.PI * 2);
          ctx.fill();
        }
      } else if (game.scene === 'launch' || game.scene === 'space') {
        const sky = ctx.createRadialGradient(
          canvas.width * 0.5,
          canvas.height * 0.45,
          50,
          canvas.width * 0.5,
          canvas.height * 0.5,
          canvas.width * 0.7
        );
        sky.addColorStop(0, '#091a2d');
        sky.addColorStop(0.3, '#0a1f35');
        sky.addColorStop(1, '#000712');
        ctx.fillStyle = sky;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // stars
        for (let i = 0; i < 120; i++) {
          const x = (i * 137.1) % canvas.width;
          const y = (i * 78.9) % canvas.height;
          ctx.fillStyle = `rgba(255,255,255,${(i % 6) / 10 + 0.3})`;
          ctx.fillRect(x, y, 2, 2);
        }

        // earth view
        if (game.scene === 'space') {
          ctx.fillStyle = '#2c7ff0';
          ctx.beginPath();
          ctx.arc(canvas.width * 0.7, canvas.height * 0.32, 78, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#6ec3ff';
          ctx.beginPath();
          ctx.arc(canvas.width * 0.75, canvas.height * 0.32, 60, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#47a6ff';
          ctx.beginPath();
          ctx.arc(canvas.width * 0.66, canvas.height * 0.34, 18, 0, Math.PI * 2);
          ctx.fill();
        }

        // moon / mars planet
        if (mission.destination === 'moon') {
          ctx.fillStyle = '#dfe6ee';
          ctx.beginPath();
          ctx.arc(canvas.width * 0.28, canvas.height * 0.6, 95, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#c0cacf';
          ctx.beginPath();
          ctx.arc(canvas.width * 0.36, canvas.height * 0.62, 22, 0, Math.PI * 2);
          ctx.fill();
        } else if (mission.destination === 'mars') {
          ctx.fillStyle = '#d45732';
          ctx.beginPath();
          ctx.arc(canvas.width * 0.25, canvas.height * 0.62, 100, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#b85028';
          ctx.beginPath();
          ctx.arc(canvas.width * 0.32, canvas.height * 0.66, 25, 0, Math.PI * 2);
          ctx.fill();
        }
      } else if (game.scene === 'moon') {
        const moon = ctx.createRadialGradient(
          canvas.width * 0.5,
          canvas.height * 0.5,
          50,
          canvas.width * 0.5,
          canvas.height * 0.5,
          canvas.width
        );
        moon.addColorStop(0, '#dde7ef');
        moon.addColorStop(0.2, '#cbd5dd');
        moon.addColorStop(1, '#8a9298');
        ctx.fillStyle = moon;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // craters
        for (let i = 0; i < 28; i++) {
          ctx.fillStyle = 'rgba(110,116,122,0.42)';
          ctx.beginPath();
          ctx.arc((i * 119) % canvas.width, (i * 73) % canvas.height, 20 + (i % 7) * 8, 0, Math.PI * 2);
          ctx.fill();
        }
      } else if (game.scene === 'mars') {
        const mars = ctx.createRadialGradient(
          canvas.width * 0.5,
          canvas.height * 0.5,
          60,
          canvas.width * 0.5,
          canvas.height * 0.5,
          canvas.width
        );
        mars.addColorStop(0, '#de7b56');
        mars.addColorStop(0.35, '#bb5633');
        mars.addColorStop(1, '#592716');
        ctx.fillStyle = mars;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // rock formations
        for (let i = 0; i < 26; i++) {
          ctx.fillStyle = 'rgba(76,26,17,0.7)';
          ctx.beginPath();
          ctx.moveTo((i * 71) % canvas.width, (i * 31) % canvas.height);
          ctx.lineTo(((i * 71) % canvas.width) + 35, ((i * 31) % canvas.height) - 28);
          ctx.lineTo(((i * 71) % canvas.width) + 70, ((i * 31) % canvas.height) + 18);
          ctx.closePath();
          ctx.fill();
        }
      }
    }

    function drawBuildings() {
      if (game.scene !== 'earth') return;
      for (const b of worldObjects.buildings) {
        const x = b.x - game.view.x;
        const y = b.y - game.view.y;
        ctx.fillStyle = b.color;
        ctx.fillRect(x, y, b.w, b.h);
        ctx.fillStyle = 'rgba(255,255,255,0.12)';
        ctx.fillRect(x + 8, y + 8, b.w - 16, 10);
      }

      // rocket station
      const station = worldObjects.rocketStation;
      const sx = station.x - game.view.x;
      const sy = station.y - game.view.y;

      ctx.fillStyle = '#b7c6d7';
      ctx.fillRect(sx, sy, station.w * 0.7, station.h * 0.4);
      ctx.fillStyle = '#8aa0b6';
      ctx.fillRect(sx + 38, sy + 20, station.w * 0.28, station.h * 0.28);

      // launch pad
      ctx.fillStyle = '#556c81';
      ctx.fillRect(sx - 50, sy + 110, station.w + 100, 40);
      ctx.fillStyle = '#95a5b3';
      ctx.fillRect(sx + 40, sy + 154, 120, 20);

      const dist = Math.hypot(player.x - station.x, player.y - station.y);
      if (dist < 190 && game.scene === 'earth') {
        ctx.fillStyle = 'rgba(255,255,255,0.9)';
        ctx.font = 'bold 14px Arial';
        ctx.fillText('Press E to enter rocket', sx - 10, sy - 20);
      }
    }

    function drawCoins() {
      if (game.scene !== 'earth' && game.scene !== 'moon' && game.scene !== 'mars') return;
      for (const coin of worldObjects.coins) {
        const x = coin.x - game.view.x;
        const y = coin.y - game.view.y;
        if (x < -20 || x > canvas.width + 20 || y < -20 || y > canvas.height + 20) continue;
        ctx.fillStyle = '#ffd166';
        ctx.beginPath();
        ctx.arc(x, y, coin.radius, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function drawEnemies() {
      if (game.scene === 'earth' || game.scene === 'moon' || game.scene === 'mars') {
        for (const enemy of worldObjects.enemies) {
          if (!enemy.alive) continue;
          const x = enemy.x - game.view.x;
          const y = enemy.y - game.view.y;
          if (x < -40 || x > canvas.width + 40 || y < -40 || y > canvas.height + 40) continue;

          ctx.fillStyle = enemy.kind === 'guard' ? '#ff7a59' : enemy.kind === 'assassin' ? '#d34bff' : '#49d0ff';
          ctx.beginPath();
          ctx.arc(x, y, enemy.radius, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(x - 18, y - 28, 36, 5);
          ctx.fillStyle = '#53ff7a';
          ctx.fillRect(x - 18, y - 28, (enemy.hp / 80) * 36, 5);
        }
      }
    }

    function drawPlayer() {
      const x = player.x - game.view.x;
      const y = player.y - game.view.y;

      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(player.angle);

      // shadow
      ctx.fillStyle = 'rgba(0,0,0,0.28)';
      ctx.beginPath();
      ctx.ellipse(0, 14, 20, 12, 0, 0, Math.PI * 2);
      ctx.fill();

      // body
      ctx.fillStyle = '#0ec6ff';
      ctx.beginPath();
      ctx.arc(0, 0, player.radius, 0, Math.PI * 2);
      ctx.fill();

      // visor
      ctx.fillStyle = '#bff4ff';
      ctx.fillRect(-8, -6, 16, 8);

      // weapon
      ctx.fillStyle = '#d4d8de';
      ctx.fillRect(16, -2, 14, 4);

      ctx.restore();
    }

    function drawRocket() {
      if (!rocket.active && game.scene !== 'launch') return;
      const x = rocket.x - game.view.x;
      const y = rocket.y - game.view.y;

      ctx.save();
      ctx.translate(x, y + rocket.progress * 1.3);
      ctx.fillStyle = '#d9e4ef';
      ctx.fillRect(-24, -70, 48, 110);

      ctx.fillStyle = '#ff8a00';
      ctx.fillRect(-12, 40, 24, 30);

      ctx.fillStyle = '#1a1a20';
      ctx.fillRect(-18, -84, 36, 18);

      ctx.fillStyle = '#ff4d4d';
      ctx.fillRect(-14, 70, 10, 28);
      ctx.fillRect(4, 70, 10, 28);

      // flame
      if (game.scene === 'launch') {
        const flame = 12 + Math.sin(game.gameTime * 15) * 8;
        ctx.fillStyle = '#ffdd6a';
        ctx.beginPath();
        ctx.moveTo(-10, 100);
        ctx.lineTo(0, 100 + flame);
        ctx.lineTo(10, 100);
        ctx.closePath();
        ctx.fill();
      }

      ctx.restore();

      // rocket thruster dust
      if (game.scene === 'launch') {
        for (let i = 0; i < 8; i++) {
          const px = rocket.x + rand(-18, 18) - game.view.x;
          const py = rocket.y + rand(80, 120) - game.view.y;
          ctx.fillStyle = `rgba(255, ${160 + i * 10}, 70, 0.5)`;
          ctx.fillRect(px, py, 5, 10);
        }
      }
    }

    function updateCamera() {
      const targetX = clamp(player.x - canvas.width / 2, 0, world.width - canvas.width);
      const targetY = clamp(player.y - canvas.height / 2, 0, world.height - canvas.height);
      game.view.x += (targetX - game.view.x) * 0.12;
      game.view.y += (targetY - game.view.y) * 0.12;
    }

    function handleMovement() {
      let dx = 0;
      let dy = 0;

      if (keys['KeyW'] || keys['ArrowUp']) dy -= 1;
      if (keys['KeyS'] || keys['ArrowDown']) dy += 1;
      if (keys['KeyA'] || keys['ArrowLeft']) dx -= 1;
      if (keys['KeyD'] || keys['ArrowRight']) dx += 1;

      if (dx !== 0 || dy !== 0) {
        const len = Math.hypot(dx, dy) || 1;
        dx /= len; dy /= len;
        const sprint = keys['ShiftLeft'] || keys['ShiftRight'] ? player.sprintSpeed : player.speed;
        if (player.energy > 0 && (keys['ShiftLeft'] || keys['ShiftRight'])) {
          player.energy -= 0.8;
        } else {
          player.energy = clamp(player.energy + 0.3, 0, 100);
        }

        player.x += dx * sprint * (1 / 60);
        player.y += dy * sprint * (1 / 60);
        player.angle = Math.atan2(dy, dx);
        player.facing.x = dx;
        player.facing.y = dy;
      } else {
        player.energy = clamp(player.energy + 0.5, 0, 100);
      }

      player.x = clamp(player.x, 30, world.width - 30);
      player.y = clamp(player.y, 30, world.height - 30);
    }

    function collectCoins() {
      if (game.scene === 'earth' || game.scene === 'moon' || game.scene === 'mars') {
        for (let i = worldObjects.coins.length - 1; i >= 0; i--) {
          const coin = worldObjects.coins[i];
          const dist = Math.hypot(player.x - coin.x, player.y - coin.y);
          if (dist < 30) {
            player.coins += coin.value;
            worldObjects.coins.splice(i, 1);
            showToast('+1 coin');
          }
        }
      }
    }

    function checkInteract() {
      const station = worldObjects.rocketStation;
      if (game.scene === 'earth') {
        const dist = Math.hypot(player.x - station.x, player.y - station.y);
        if (dist < 180 && keys['KeyE']) {
          startRocketLaunch();
        }
      }
    }

    function startRocketLaunch() {
      if (rocket.active || game.scene !== 'earth') return;
      rocket.active = true;
      rocket.stage = 'launching';
      rocket.x = 1550;
      rocket.y = 1090;
      rocket.progress = 0;
      rocket.launchPhase = 0;
      game.scene = 'launch';
      setMission('Launch to Orbit', 'Enter the rocket and ascend through Earth atmosphere.');
      showToast('Rocket countdown: 10...9...8...');
      ui.missionText.textContent = 'Mission: Launch to Orbit';
      mission.destination = null;
    }

    function updateRocketSequence() {
      if (!rocket.active || game.scene !== 'launch') return;

      rocket.progress += 0.025;
      rocket.launchPhase += 0.04;

      if (rocket.progress > 1.2) {
        game.scene = 'space';
        rocket.active = false;
        mission.destination = null;
        setMission('Choose Destination', 'Select the Moon or Mars to continue your mission.');
        ui.missionText.textContent = 'Mission: Choose Destination';
        showToast('Space travel complete. Choose destination.');
        document.getElementById('missionOverlay').classList.add('visible');
      }
    }

    function fireWeapon() {
      if (player.fireCooldown > 0 || player.ammo <= 0) return;
      player.fireCooldown = 0.18;
      player.ammo -= 1;

      const shot = {
        x: player.x + player.facing.x * 28,
        y: player.y + player.facing.y * 28,
        vx: player.facing.x * 640,
        vy: player.facing.y * 640,
        life: 0.65,
        radius: 5
      };

      // projectile for enemies
      if (game.scene === 'earth' || game.scene === 'moon' || game.scene === 'mars') {
        for (const enemy of worldObjects.enemies) {
          if (!enemy.alive) continue;
          const dist = Math.hypot(enemy.x - shot.x, enemy.y - shot.y);
          if (dist < 200) {
            enemy.hp -= 22;
            if (enemy.hp <= 0) {
              enemy.alive = false;
              player.coins += 6;
              mission.kills += 1;
              showToast('Enemy neutralized');
            }
            break;
          }
        }
      }

      player.energy = clamp(player.energy - 5, 0, 100);
      if (player.ammo <= 0 && mission.current.includes('Earth')) {
        setMission('Reload and Survive', 'Find supplies or collect more ammo.');
      }
    }

    function updateEnemies() {
      if (game.scene !== 'earth' && game.scene !== 'moon' && game.scene !== 'mars') return;

      for (const enemy of worldObjects.enemies) {
        if (!enemy.alive) continue;
        const dx = player.x - enemy.x;
        const dy = player.y - enemy.y;
        const dist = Math.hypot(dx, dy);
        if (dist < 220) {
          enemy.x += (dx / (dist || 1)) * enemy.speed * 0.016;
          enemy.y += (dy / (dist || 1)) * enemy.speed * 0.016;
          if (dist < 34) {
            player.health -= 0.9;
            player.shield -= 0.4;
            if (player.shield < 0) {
              player.shield = 0;
            }
          }
        }
      }

      if (mission.kills >= 5 && game.scene === 'earth' && mission.current === 'Secure the Island') {
        setMission('Launch to Space', 'Reach the rocket launch station and enter the rocket.');
        showToast('Primary objective complete – head to the rocket station.');
      }

      if (game.scene === 'moon' && mission.destination === 'moon') {
        // if user reaches 10 total kills on moon
        if (mission.kills >= 8) {
          setMission('Moon Victory', 'Mission complete. You can now explore Mars.');
          showToast('Moon objective complete.');
        }
      }

      if (game.scene === 'mars' && mission.destination === 'mars') {
        if (mission.kills >= 10) {
          setMission('Mars Base secured', 'Mission complete. All systems stable.');
          showToast('Mars victory! Base upgraded.');
        }
      }
    }

    function resetMissionForDestination(dest) {
      mission.destination = dest;
      if (dest === 'moon') {
        game.scene = 'moon';
        ui.missionText.textContent = 'Mission: Lunar Assault';
        setMission('Lunar Assault', 'Defeat enemies and gather gold in the moon battlefield.');
        player.x = 900;
        player.y = 720;
        worldObjects.enemies.forEach((e, i) => { e.alive = true; e.hp = 60 + i * 4; e.x = 100 + Math.random() * 1200; e.y = 100 + Math.random() * 800; });
        worldObjects.coins = Array.from({ length: 30 }, () => ({ x: 80 + Math.random() * 1200, y: 80 + Math.random() * 750, radius: 8, value: 1 }));
      } else if (dest === 'mars') {
        game.scene = 'mars';
        ui.missionText.textContent = 'Mission: Martian Frontier';
        setMission('Martian Frontier', 'Explore red deserts, caves, and alien ruins for treasures and rewards.');
        player.x = 900;
        player.y = 680;
        worldObjects.enemies.forEach((e, i) => { e.alive = true; e.hp = 70 + i * 5; e.x = 100 + Math.random() * 1200; e.y = 100 + Math.random() * 800; });
        worldObjects.coins = Array.from({ length: 30 }, () => ({ x: 80 + Math.random() * 1200, y: 80 + Math.random() * 750, radius: 8, value: 1 }));
      }

      // close destination panel
      document.getElementById('missionOverlay').classList.remove('visible');
      ui.locationState.textContent = dest === 'moon' ? 'Moon Basin' : 'Mars Frontier';
      mission.kills = 0;
      showToast(dest === 'moon' ? 'Landed on the Moon' : 'Landed on Mars');
    }

    function updateScene() {
      if (game.scene === 'earth') {
        world.width = 2600;
        world.height = 1800;
      } else if (game.scene === 'moon' || game.scene === 'mars') {
        world.width = 1400;
        world.height = 900;
      }

      if (game.scene === 'earth' || game.scene === 'moon' || game.scene === 'mars') {
        updateCamera();
      }
    }

    function update() {
      game.gameTime += 1;
      if (game.pause || !game.started) return;

      if (player.health <= 0) {
        player.health = 100;
        player.shield = 100;
        player.energy = 100;
        showToast('You were revived at the drop zone.');
      }

      if (game.scene === 'earth' || game.scene === 'moon' || game.scene === 'mars') {
        handleMovement();
        collectCoins();
        updateEnemies();
        updateScene();

        if (player.fireCooldown > 0) player.fireCooldown -= 1 / 60;

        // automatic reload if ammo 0
        if (player.ammo <= 0) {
          player.ammo = 18;
          showToast('Reloaded');
        }

        checkInteract();
      }

      if (game.scene === 'launch') {
        updateRocketSequence();
      }

      if (game.scene === 'space') {
        // still allow selecting destination via overlay
      }

      updateHud();
    }

    function draw() {
      drawBackground();
      if (game.scene === 'earth') {
        drawBuildings();
      }
      drawCoins();
      drawEnemies();
      drawPlayer();
      drawRocket();

      // world markers
      if (game.scene === 'earth') {
        const station = worldObjects.rocketStation;
        ctx.fillStyle = 'rgba(255,255,255,0.08)';
        ctx.fillRect(station.x - game.view.x - 20, station.y - game.view.y + 100, 110, 35);
      }
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    function startGame() {
      generateWorld();
      resetPlayerForEarth();
      game.started = true;
      game.paused = false;
      game.scene = 'earth';
      ui.mainMenu.classList.remove('visible');
      ui.pauseOverlay.classList.remove('visible');
      ui.missionOverlay.classList.remove('visible');
      showToast('Mission started. Explore the island and find the rocket.');
    }

    document.getElementById('startBtn').addEventListener('click', startGame);
    document.getElementById('missionBtn').addEventListener('click', () => {
      ui.mainMenu.classList.remove('visible');
      ui.missionOverlay.classList.add('visible');
      ui.pauseOverlay.classList.remove('visible');
    });

    document.getElementById('settingsBtn').addEventListener('click', () => {
      ui.mainMenu.classList.remove('visible');
      ui.settingsOverlay.classList.add('visible');
    });

    document.getElementById('closeSettingsBtn').addEventListener('click', () => {
      ui.settingsOverlay.classList.remove('visible');
      ui.mainMenu.classList.add('visible');
    });

    document.getElementById('resumeBtn').addEventListener('click', () => {
      game.paused = false;
      ui.pauseOverlay.classList.remove('visible');
    });

    document.getElementById('menuBtn').addEventListener('click', () => {
      game.paused = false;
      game.started = false;
      ui.pauseOverlay.classList.remove('visible');
      ui.mainMenu.classList.add('visible');
    });

    document.querySelectorAll('[data-destination]').forEach(btn => {
      btn.addEventListener('click', () => {
        const dest = btn.getAttribute('data-destination');
        resetMissionForDestination(dest);
      });
    });

    document.addEventListener('keydown', (e) => {
      keys[e.code] = true;

      if (e.code === 'KeyE') {
        checkInteract();
      }

      if (e.code === 'Space') {
        fireWeapon();
      }

      if (e.code === 'Escape') {
        if (game.started) {
          game.paused = !game.paused;
          ui.pauseOverlay.classList.toggle('visible', game.paused);
        }
      }
    });

    document.addEventListener('keyup', (e) => {
      keys[e.code] = false;
    });

    document.addEventListener('pointerdown', (e) => {
      if (game.started && !game.paused) {
        fireWeapon();
      }
    });

    document.getElementById('fireBtn').addEventListener('click', () => fireWeapon());
    document.getElementById('interactBtn').addEventListener('click', () => checkInteract());

    document.querySelectorAll('.touch-btn').forEach(btn => {
      btn.addEventListener('pointerdown', () => {
        const key = btn.getAttribute('data-key');
        keys[key] = true;
      });
      btn.addEventListener('pointerup', () => {
        const key = btn.getAttribute('data-key');
        keys[key] = false;
      });
      btn.addEventListener('pointerleave', () => {
        const key = btn.getAttribute('data-key');
        keys[key] = false;
      });
    });

    ui.performanceToggle.addEventListener('change', () => {
      game.performanceMode = ui.performanceToggle.checked;
      if (game.performanceMode) {
        showToast('Performance mode enabled');
      } else {
        showToast('Performance mode disabled');
      }
    });

    function rgba(r, g, b, a = 1) {
      return `rgba(${r}, ${g}, ${b}, ${a})`;
    }

    // start default world
    generateWorld();
    resetPlayerForEarth();
    updateHud();
    requestAnimationFrame(loop);
  </script>
</body>
</html>
